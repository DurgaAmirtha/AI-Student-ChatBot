# AI Student Chatbot Environment Configuration

# Google Gemini API Key (Get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# JWT Secret Key for Session Authentication
JWT_SECRET=super_secret_jwt_key_change_in_production_123456789

# JWT Algorithm and Expiration
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database URL (SQLite default)
DATABASE_URL=sqlite:///./student_assistant.db

# Storage Directory for Uploads
UPLOAD_DIR=backend/uploads
